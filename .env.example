# ── Base de datos (OBLIGATORIA para activar cuentas, comunidad y links con fotos) ──
# Cualquier Postgres: Neon, Vercel Postgres, Supabase… Las tablas se crean solas (db/schema.sql).
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require

# ── Sesiones (OBLIGATORIA en producción): una cadena larga y aleatoria ──
# Genera una con:  openssl rand -base64 32
SESSION_SECRET=

# ── Fotos (opcional): Vercel Blob. Sin esto, las fotos se guardan en Postgres ──
BLOB_READ_WRITE_TOKEN=

# ── Spotify (opcional): búsqueda de canciones y "Continuar con Spotify" ──
# https://developer.spotify.com/dashboard → Create app → Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Solo si tu dominio no se detecta bien. Debe coincidir con el Redirect URI de la app de Spotify:
# SPOTIFY_REDIRECT_URI=https://tu-dominio.com/api/auth/spotify/callback

# ── Pagos Wompi (opcional): activa "Pagar plan" en Planes ──
# Panel de Wompi → Desarrolladores. Con llaves pub_test_… funciona en Sandbox; con pub_prod_… cobra de verdad.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ── Correo (opcional): recuperar contraseña. Resend: https://resend.com ──
RESEND_API_KEY=
# Remitente. Con tu dominio verificado en Resend, p. ej.: Mixzine <hola@tu-dominio.com>
# Sin dominio verificado, Resend solo envía a tu propio correo (modo de pruebas).
MAIL_FROM=Mixzine <onboarding@resend.dev>
# Solo desarrollo: imprime el enlace de recuperación en la consola en vez de enviar correo
# MAIL_DEBUG=1

# ── Otros ──
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
# Pon 0 cuando la comunidad ya tenga contenido real, para ocultar los fanzines de prueba:
# NEXT_PUBLIC_DEMO_FEED=0
